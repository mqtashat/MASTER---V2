{
  "name": "master-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bash local/reset_db.sh && node --test --test-concurrency=1 --test-reporter=spec db/*.test.mjs",
    "e2e": "bash local/reset_db.sh && node e2e/module1.e2e.mjs && bash local/reset_db.sh && node e2e/module2.e2e.mjs && bash local/reset_db.sh && node e2e/module3.e2e.mjs && bash local/reset_db.sh && node e2e/module4.e2e.mjs && bash local/reset_db.sh && node e2e/module5.e2e.mjs && bash local/reset_db.sh && node e2e/module6.e2e.mjs && bash local/reset_db.sh && node e2e/module7.e2e.mjs",
    "e2e:1": "bash local/reset_db.sh && node e2e/module1.e2e.mjs",
    "e2e:2": "bash local/reset_db.sh && node e2e/module2.e2e.mjs",
    "e2e:3": "bash local/reset_db.sh && node e2e/module3.e2e.mjs",
    "e2e:4": "bash local/reset_db.sh && node e2e/module4.e2e.mjs",
    "e2e:5": "bash local/reset_db.sh && node e2e/module5.e2e.mjs",
    "e2e:6": "bash local/reset_db.sh && node e2e/module6.e2e.mjs",
    "load:100k": "node load/load.mjs --rows 100000 --months 7 --out load/out/load-100k.json",
    "load:500k": "node load/load.mjs --rows 500000 --months 10 --out load/out/load-500k.json",
    "load:report": "node load/report.mjs load/out/load-100k.json load/out/load-500k.json",
    "e2e:7": "bash local/reset_db.sh && node e2e/module7.e2e.mjs"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "xlsx": "^0.18.5"
  }
}
